---
const PROJECT_NAME = 'Toby';
const PROJECT_SLUG = 'toby';
const PROJECT_DESCRIPTION = 'Landing page';
// Endpoint that receives requirement submissions (Brotea bot/orchestrator).
// Public, unauthenticated Brotea endpoint. Override at build time with
// PUBLIC_REQUIREMENTS_ENDPOINT if this site should post elsewhere.
// Keep `||`, never `??`: the Dockerfile defaults the ARG to an empty string,
// which is not nullish, so `??` would ship an empty endpoint again.
const DEFAULT_ENDPOINT = 'https://api.brotea.dev/requirements';
const ENDPOINT = import.meta.env.PUBLIC_REQUIREMENTS_ENDPOINT?.trim() || DEFAULT_ENDPOINT;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{PROJECT_NAME}</title>
    <meta name="description" content={PROJECT_DESCRIPTION} />
      <script is:inline defer src={import.meta.env.PUBLIC_UMAMI_SRC} data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}></script>
      <script is:inline defer id="brotea-errors" src="/brotea-errors.js" data-dsn={import.meta.env.PUBLIC_GLITCHTIP_DSN}></script>
  </head>
  <body>
    <main>
      <section class="hero">
        <h1>{PROJECT_NAME}</h1>
        <p>{PROJECT_DESCRIPTION}</p>
        <p class="hero-cta"><a href="/game">Play the game 🚽</a></p>
        <p class="roadmap-link"><a href="/roadmap">Roadmap</a></p>
      </section>

      <section class="form-card">
        <h2>Tell us what you need</h2>
        <p>Your input shapes what gets built first.</p>
        <form id="requirements-form" data-endpoint={ENDPOINT} data-project={PROJECT_SLUG}>
          <label>
            Name
            <input type="text" name="name" required maxlength="120" />
          </label>
          <label>
            Email
            <input type="email" name="email" required maxlength="200" />
          </label>
          <label>
            What should this project do for you?
            <textarea name="content" required rows="5" maxlength="4000"></textarea>
          </label>
          <button type="submit">Send</button>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>

    <script>
      const form = document.getElementById('requirements-form');
      const status = document.getElementById('form-status');
      const button = form?.querySelector('button[type="submit"]');
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!status) return;
        const endpoint = form.dataset.endpoint;
        if (!endpoint) {
          status.textContent = 'Submissions are not enabled yet.';
          return;
        }
        const data = Object.fromEntries(new FormData(form));
        status.textContent = 'Sending...';
        if (button) button.disabled = true;
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              project: form.dataset.project,
              source: 'landing_form',
              submitted_by: `${data.name} <${data.email}>`,
              content: data.content,
            }),
            // Without a deadline a blackholed API never settles the promise:
            // `finally` never runs and the form stays stuck on 'Sending...'.
            signal: AbortSignal.timeout(15000),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          form.reset();
          status.textContent = 'Thank you! We received your input.';
        } catch (err) {
          console.error('Requirements submission failed:', err);
          status.textContent = describeFailure(err);
        } finally {
          if (button) button.disabled = false;
        }
      });

      function describeFailure(err) {
        const name = err instanceof DOMException ? err.name : '';
        if (name === 'TimeoutError' || name === 'AbortError') {
          return 'That took too long - please try again in a moment.';
        }
        if (err instanceof Error && err.message === 'HTTP 429') {
          return 'Too many submissions - please wait a minute and try again.';
        }
        const detail = err instanceof Error && err.message ? ` (${err.message})` : '';
        return `Something went wrong${detail} - please try again later.`;
      }
    </script>

    <style>
      * { box-sizing: border-box; }
      body { margin: 0; font-family: system-ui, sans-serif; color: #1a1a1a; background: #fafafa; }
      main { max-width: 640px; margin: 0 auto; padding: 4rem 1.5rem; }
      .hero h1 { font-size: 2.5rem; margin: 0 0 .5rem; }
      .hero p { font-size: 1.15rem; color: #444; }
      .roadmap-link a { color: #1a7f37; font-weight: 600; }
      .hero-cta a { color: #1a7f37; font-weight: 600; text-decoration: none; }
      .hero-cta a:hover { text-decoration: underline; }
      .form-card { margin-top: 3rem; background: #fff; border: 1px solid #e2e2e2; border-radius: 12px; padding: 2rem; }
      label { display: block; margin-bottom: 1rem; font-weight: 600; }
      input, textarea { display: block; width: 100%; margin-top: .35rem; padding: .6rem; border: 1px solid #ccc; border-radius: 8px; font: inherit; }
      button { padding: .7rem 1.6rem; border: 0; border-radius: 8px; background: #1a7f37; color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
      button:hover { background: #166b2f; }
      #form-status { min-height: 1.2em; color: #555; }
    </style>
  </body>
</html>
