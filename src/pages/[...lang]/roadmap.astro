---
// Self-contained public roadmap page: no Layout, no React island, no env vars.
// It must work in bare landing-astro projects, so everything (markup, fetch
// logic, styles) lives in this one file. The installer replaces the
// placeholders below (the CLI copies files verbatim; substitution is the
// agent's job, same as the stack-template placeholders).
const PROJECT_NAME = 'Toby';
const PROJECT_SLUG = 'toby';
const ENDPOINT = `https://api.brotea.dev/roadmap?project=${PROJECT_SLUG}`;
import '../../styles/theme.css';
import { dirOf, localePath, localePaths, t } from '../../lib/i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props;
const COLUMNS = ['planned', 'in_progress', 'shipped'] as const;
---

<html lang={locale} dir={dirOf(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t(locale, 'roadmap.title')} — {PROJECT_NAME}</title>
    <meta name="description" content={t(locale, 'roadmap.subtitle')} />
  </head>
  <body>
    <main>
      <section class="hero">
        <h1>{t(locale, 'roadmap.title')}</h1>
        <p>{t(locale, 'roadmap.subtitle')}</p>
        <p><a href={localePath(locale, '/')}>{t(locale, 'roadmap.back')}</a></p>
      </section>

      <!-- The client script is shared by every locale, so its runtime strings
           travel as data-* attributes rendered server-side. -->
      <section
        id="roadmap"
        data-endpoint={ENDPOINT}
        data-msg-error={t(locale, 'roadmap.error')}
        data-msg-empty={t(locale, 'roadmap.empty')}
      >
        <p id="roadmap-status" role="status">{t(locale, 'roadmap.loading')}</p>
        <div class="columns" hidden>
          {COLUMNS.map((status) => (
            <div class="column" data-status={status}>
              <h2>{t(locale, `roadmap.column.${status}`)}</h2>
              <ul></ul>
            </div>
          ))}
        </div>
      </section>
    </main>

    <script>
      // Tipado explícito: getElementById devuelve HTMLElement|null y
      // querySelector devuelve Element, que no tiene dataset ni hidden.
      const root = document.getElementById('roadmap') as HTMLElement;
      const status = document.getElementById('roadmap-status') as HTMLElement;
      const columns = root.querySelector('.columns') as HTMLElement;

      function render(items) {
        const cols = [...columns.querySelectorAll<HTMLElement>('.column')];
        for (const item of items) {
          const list = cols.find((c) => c.dataset.status === item.status)?.querySelector('ul');
          if (!list) continue;
          const li = document.createElement('li');
          const title = document.createElement('strong');
          title.textContent = item.title;
          li.appendChild(title);
          if (item.description) {
            const p = document.createElement('p');
            p.textContent = item.description;
            li.appendChild(p);
          }
          list.appendChild(li);
        }
        for (const col of columns.querySelectorAll<HTMLElement>('.column')) {
          if (!col.querySelector('li')) {
            const li = document.createElement('li');
            li.className = 'empty';
            li.textContent = root.dataset.msgEmpty;
            col.querySelector('ul').appendChild(li);
          }
        }
      }

      (async () => {
        try {
          const res = await fetch(root.dataset.endpoint, { signal: AbortSignal.timeout(8000) });
          if (!res.ok) throw new Error(String(res.status));
          const data = await res.json();
          render(data.items ?? []);
          status.hidden = true;
          columns.hidden = false;
        } catch {
          status.textContent = root.dataset.msgError;
        }
      })();
    </script>

    <style>
      * { box-sizing: border-box; }
      body { margin: 0; font-family: var(--font-sans); color: var(--text); background: var(--bg); }
      main { max-width: 960px; margin: 0 auto; padding: 4rem var(--space-4); }
      .hero h1 { font-family: var(--font-display); font-size: 2.5rem; margin: 0 0 .5rem; }
      .hero p { font-size: 1.15rem; color: var(--muted); }
      .hero a { color: var(--primary); }
      .columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-4); margin-top: var(--space-5); }
      .columns[hidden] { display: none; }
      .column { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-5); }
      .column h2 { margin: 0 0 .75rem; font-size: 1.1rem; }
      .column ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .75rem; }
      /* Items are created client-side, so they lack Astro's scope attribute —
         these rules must be global to reach them. */
      .column :global(li) { border: 1px solid var(--border); border-radius: var(--radius); padding: .75rem; background: var(--bg); }
      .column :global(li p) { margin: .35rem 0 0; font-size: .9rem; color: var(--muted); }
      .column :global(li.empty) { border-style: dashed; color: var(--muted); font-size: .9rem; }
      [data-status="shipped"] h2 { color: var(--ok); }
      #roadmap-status { color: var(--muted); }
    </style>
  </body>
</html>
