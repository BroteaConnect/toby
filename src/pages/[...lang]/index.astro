---
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { alternates, dirOf, localePath, localePaths, stripLocale, t } from '../../lib/i18n';

// One file, every language: / (default locale) and /<code>/ for the rest.
export const getStaticPaths = localePaths;
const { locale } = Astro.props;
const i18nPath = stripLocale(Astro.url.pathname);
const abs = (href: string) => (Astro.site ? new URL(href, Astro.site).href : href);
import '../../styles/theme.css';
const PROJECT_NAME = 'Toby';
const PROJECT_SLUG = 'toby';
const PROJECT_DESCRIPTION = 'Landing page';
// Endpoint that receives requirement submissions (Brotea bot/orchestrator).
// Public, unauthenticated Brotea endpoint. Override at build time with
// PUBLIC_REQUIREMENTS_ENDPOINT if this site should post elsewhere.
// Keep `||`, never `??`: the Dockerfile defaults the ARG to an empty string,
// which is not nullish, so `??` would ship an empty endpoint again.
const DEFAULT_ENDPOINT = 'https://api.brotea.dev/requirements';
const ENDPOINT = import.meta.env.PUBLIC_REQUIREMENTS_ENDPOINT?.trim() || DEFAULT_ENDPOINT;
---

<html lang={locale} dir={dirOf(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{PROJECT_NAME}</title>
    <meta name="description" content={t(locale, 'hero.tagline')} />
    {alternates(i18nPath).map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={abs(a.href)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(localePath(locale, i18nPath))} />
      <script is:inline defer src={import.meta.env.PUBLIC_UMAMI_SRC} data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}></script>
      <script is:inline defer id="brotea-errors" src="/brotea-errors.js" data-dsn={import.meta.env.PUBLIC_GLITCHTIP_DSN}></script>
  </head>
  <body>
    <header class="lang-bar"><LanguageSwitcher locale={locale} /></header>
    <main>
      <section class="hero">
        <h1>{PROJECT_NAME}</h1>
        <p>{t(locale, 'hero.tagline')}</p>
        <p class="hero-cta"><a href={localePath(locale, '/game')}>{t(locale, 'game.cta')}</a></p>
        <p class="roadmap-link"><a href="/roadmap">Roadmap</a></p>
      </section>

      <section class="form-card">
        <h2>{t(locale, 'form.title')}</h2>
        <p>{t(locale, 'form.subtitle')}</p>
        <form
          id="requirements-form"
          data-endpoint={ENDPOINT}
          data-project={PROJECT_SLUG}
          data-msg-disabled={t(locale, 'form.disabled')}
          data-msg-sending={t(locale, 'form.sending')}
          data-msg-thanks={t(locale, 'form.thanks')}
          data-msg-error={t(locale, 'form.error')}
          data-msg-timeout={t(locale, 'form.timeout')}
          data-msg-too-many={t(locale, 'form.tooMany')}
          data-msg-error-detail={t(locale, 'form.errorDetail')}
        >
          <label>
            {t(locale, 'form.name')}
            <input type="text" name="name" required maxlength="120" />
          </label>
          <label>
            {t(locale, 'form.email')}
            <input type="email" name="email" required maxlength="200" />
          </label>
          <label>
            {t(locale, 'form.message')}
            <textarea name="content" required rows="5" maxlength="4000"></textarea>
          </label>
          <button type="submit">{t(locale, 'form.submit')}</button>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>

    <script>
      // tipado explícito: getElementById devuelve HTMLElement, y sin esto
      // `form.reset()` y `new FormData(form)` no compilan (astro check)
      const form = document.getElementById('requirements-form') as HTMLFormElement;
      const status = document.getElementById('form-status');
      const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!status) return;
        const endpoint = form.dataset.endpoint;
        if (!endpoint) {
          status.textContent = form.dataset.msgDisabled;
          return;
        }
        const data = Object.fromEntries(new FormData(form));
        status.textContent = form.dataset.msgSending;
        if (button) button.disabled = true;
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              project: form.dataset.project,
              source: 'landing_form',
              submitted_by: `${data.name} <${data.email}>`,
              content: data.content,
            }),
            // Without a deadline a blackholed API never settles the promise:
            // `finally` never runs and the form stays stuck on 'Sending...'.
            signal: AbortSignal.timeout(15000),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          form.reset();
          status.textContent = form.dataset.msgThanks;
        } catch (err) {
          console.error('Requirements submission failed:', err);
          status.textContent = describeFailure(err);
        } finally {
          if (button) button.disabled = false;
        }
      });

      function describeFailure(err) {
        const name = err instanceof DOMException ? err.name : '';
        if (name === 'TimeoutError' || name === 'AbortError') {
          return form.dataset.msgTimeout;
        }
        if (err instanceof Error && err.message === 'HTTP 429') {
          return form.dataset.msgTooMany;
        }
        const detail = err instanceof Error && err.message ? ` (${err.message})` : '';
        return form.dataset.msgErrorDetail.replace('{detail}', detail);
      }
    </script>

    <style>
      .lang-bar { max-width: var(--container); margin: 0 auto;
                  padding: var(--space-4) var(--space-4) 0; display: flex; justify-content: flex-end; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: var(--font-sans); color: var(--text); background: var(--bg); }
      main { max-width: var(--container); margin: 0 auto; padding: 4rem 1.5rem; }
      .hero h1 { font-size: 2.5rem; margin: 0 0 .5rem; }
      .hero p { font-size: 1.15rem; color: var(--muted); }
      .roadmap-link a { color: #1a7f37; font-weight: 600; }
      .hero-cta a { color: #1a7f37; font-weight: 600; text-decoration: none; }
      .hero-cta a:hover { text-decoration: underline; }
      .form-card { margin-top: 3rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 2rem; }
      label { display: block; margin-bottom: 1rem; font-weight: 600; }
      input, textarea { display: block; width: 100%; margin-top: .35rem; padding: .6rem; border: 1px solid var(--border); border-radius: var(--radius); font: inherit; }
      button { padding: .7rem 1.6rem; border: 0; border-radius: var(--radius); background: var(--primary); color: var(--primary-contrast); font: inherit; font-weight: 600; cursor: pointer; }
      button:hover { filter: brightness(0.92); }
      #form-status { min-height: 1.2em; color: var(--muted); }
    </style>
  </body>
</html>
